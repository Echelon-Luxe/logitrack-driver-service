# Copy to .env and fill in. .env is gitignored - never commit real values.
# Supabase -> Project Settings -> Database -> Connection string

DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=drivers"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=drivers"

KAFKA_BROKERS="localhost:9092"
PORT=3003
LOG_LEVEL=debug

# Ship logs to Seq as well as stdout. Unset = stdout only, which is what
# Kubernetes wants: Fluent Bit tails stdout there and would duplicate every
# line. Local Seq comes up with the infrastructure repo's
# local/docker-compose.yml; UI on http://localhost:8081.
SEQ_URL="http://localhost:5341"
# SEQ_API_KEY=""
